<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- M01 Security Baseline: Tolak cleartext HTTP tanpa enkripsi -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
